#!/bin/sh
set -e

APP_DIR="/opt/synapta/parrot"
ENV_FILE="/etc/synapta/synapta.env"
LOG_FILE="/var/log/parrot.log"
VENDOR_DIR="/opt/synapta/parrot/vendor"

export_env() {
  if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
  fi
}

wait_ip() {
  i=0
  while [ $i -lt 30 ]; do
    IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | head -n1 | cut -d/ -f1)"
    [ -n "$IP" ] && echo "$IP" && return 0
    sleep 1
    i=$((i+1))
  done
  echo ""
  return 1
}

wait_db() {
  # Wait until MariaDB is reachable (local socket or TCP)
  # Prefer using env vars if present
  DB_USER="${SYNAPTA_DB_USER:-synapta_app}"
  DB_PASS="${SYNAPTA_DB_PASS:-synapta_password}"
  DB_NAME="${SYNAPTA_DB_NAME:-chatbot_db}"

  # Detect client binary (mariadb/mysql)
  DBCLI=""
  command -v mariadb >/dev/null 2>&1 && DBCLI="mariadb"
  [ -z "$DBCLI" ] && command -v mysql >/dev/null 2>&1 && DBCLI="mysql"

  # If no client exists, don't block boot; Parrot will handle connection errors.
  [ -z "$DBCLI" ] && return 0

  i=0
  while [ $i -lt 30 ]; do
    echo "SELECT 1;" | "$DBCLI" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" >/dev/null 2>&1 && return 0
    sleep 1
    i=$((i+1))
  done

  echo "[parrot] WARN: MariaDB not ready after 30s. Starting Parrot anyway." >>"$LOG_FILE"
  return 0
}

case "$1" in
  start)
    export_env
    mkdir -p /var/log

    if [ ! -d "$APP_DIR" ]; then
      echo "[parrot] ERROR: APP_DIR not found: $APP_DIR" | tee -a "$LOG_FILE"
      exit 1
    fi

    if [ ! -d "$VENDOR_DIR" ]; then
      echo "[parrot] WARN: vendor dir not found: $VENDOR_DIR" | tee -a "$LOG_FILE"
    fi

    IP="$(wait_ip || true)"
    if [ -n "$IP" ]; then
      echo "Synapta ready: http://$IP:8000" | tee -a "$LOG_FILE"
    else
      echo "Synapta: no IP detected yet (will still start)." | tee -a "$LOG_FILE"
    fi

    cd "$APP_DIR"

    # Ensure vendored deps are discoverable
    export PYTHONPATH="$VENDOR_DIR"

    # Quick dependency sanity check
    /usr/bin/python3 -c "import fastapi, uvicorn, requests" >/dev/null 2>&1 || {
      echo "[parrot] ERROR: Missing Python deps (fastapi/uvicorn/requests). Check vendor/." | tee -a "$LOG_FILE"
      exit 1
    }

    wait_db

    # Robust restart loop for appliances
    while true; do
      /usr/bin/python3 -m uvicorn parrot:app --host 0.0.0.0 --port 8000 >>"$LOG_FILE" 2>&1 || true
      echo "[parrot] crashed, restarting in 2s..." >>"$LOG_FILE"
      sleep 2
    done
    ;;
  stop)
    # Kill uvicorn processes
    pkill -f "uvicorn parrot:app" 2>/dev/null || true
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
