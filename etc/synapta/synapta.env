# Synapta OS runtime config

# DB
SYNAPTA_DB_USER=synapta_app
SYNAPTA_DB_PASS=synapta_password
SYNAPTA_DB_NAME=chatbot_db
SYNAPTA_DB_HOST=127.0.0.1
SYNAPTA_DB_PORT=3306


# Ollama
SYNAPTA_OLLAMA_URL=http://127.0.0.1:11434/api/generate
SYNAPTA_DEFAULT_MODEL=ParrotAI1_1b:latest

# Boot resiliency
SYNAPTA_DB_STARTUP_RETRY_SECONDS=30
SYNAPTA_HTTP_CONNECT_TIMEOUT=5
SYNAPTA_HTTP_READ_TIMEOUT=300
